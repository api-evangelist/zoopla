  "info": {
    "_postman_id": "4267df6b-a23b-4a80-9a0f-ca57d389429d",
    "name": "Premium Listing activations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "This API is responsible for the activation of a premium listing product. It allows the user to:\n* Get the history of all activations they have access to\n* Get the history of all activations for given listing_id\n* Check if the given listing_id is premium in the moment of time when the call has been made\n* Activate the premium listing for the given listing\n\nThis API is asynchronous, eventually consistent and the requests are processed in the queue to protect from a situation when:\n* Consumer uses more credits than available\n* Consumer uses more than 1 credit per 1 listing\n\n\nContact Support:\n Name: Zoopla Pro P&A Team\n Email: purchaseandactivationteam@zoopla.co.uk",
      "type": "text/plain"
    }
  }
